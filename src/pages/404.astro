---
import ButtonLink from "~/components/ui/ButtonLink.astro"
import { DEFAULT_LOCALE } from "~/config/locales"
import { t } from "~/i18n/ui"
import BaseLayout from "~/layouts/BaseLayout.astro"
import { localePath } from "~/lib/i18n"

const locale = DEFAULT_LOCALE
---

<BaseLayout
  title={t(locale, "notFound.title")}
  description={t(locale, "notFound.description")}
  locale={locale}
  path="/404"
  noindex
>
  <section class="container-page py-24 text-center md:py-32">
    <p class="text-brand-700 text-sm font-semibold">404</p>
    <h1 class="text-ink mt-3 text-4xl font-bold tracking-tight">
      {t(locale, "notFound.title")}
    </h1>
    <p class="text-muted mx-auto mt-4 max-w-md text-lg">
      {t(locale, "notFound.description")}
    </p>
    <ButtonLink href={localePath(locale, "")} class="mt-8">
      {t(locale, "notFound.cta")}
    </ButtonLink>
  </section>
</BaseLayout>
