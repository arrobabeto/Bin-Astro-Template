---
import "@fontsource-variable/inter"
import "~/styles/global.css"

import type { ImageMetadata } from "astro"

import AnalyticsNoscript from "~/components/analytics/AnalyticsNoscript.astro"
import ConsentBanner from "~/components/analytics/ConsentBanner.astro"
import Footer from "~/components/layout/Footer.astro"
import Header from "~/components/layout/Header.astro"
import BaseHead from "~/components/seo/BaseHead.astro"
import { LOCALE_META, type Locale } from "~/config/locales"
import { t } from "~/i18n/ui"
import {
  graph,
  organizationJsonLd,
  webPageJsonLd,
  websiteJsonLd,
  breadcrumbJsonLd,
  type Crumb,
} from "~/lib/jsonld"
import { getSiteChrome, type Alternate } from "~/lib/routes"
import { absoluteUrl } from "~/lib/seo"

interface Props {
  title: string
  /** Título para <title> si debe diferir del visible. */
  seoTitle?: string
  description: string
  locale: Locale
  path: string
  noindex?: boolean
  canonical?: string
  alternates?: Alternate[]
  ogImage?: ImageMetadata
  updatedAt?: Date
  breadcrumbs?: Crumb[]
  /** Nodos JSON-LD extra (ej. FAQPage). */
  extraJsonLd?: Record<string, unknown>[]
}

const {
  title,
  seoTitle,
  description,
  locale,
  path,
  noindex = false,
  canonical,
  alternates = [],
  ogImage,
  updatedAt,
  breadcrumbs = [],
  extraJsonLd = [],
} = Astro.props

const chrome = await getSiteChrome(locale)
const origin = (Astro.site ?? new URL("http://localhost:4321")).origin
const url = canonical ?? absoluteUrl(path, origin)

const jsonLd = graph([
  organizationJsonLd(origin, chrome),
  websiteJsonLd(origin, chrome, locale),
  webPageJsonLd({ origin, url, title, description, locale, updatedAt }),
  ...(breadcrumbs.length > 1 ? [breadcrumbJsonLd(breadcrumbs)] : []),
  ...extraJsonLd,
])
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <BaseHead
      title={seoTitle ?? title}
      description={description}
      locale={locale}
      path={path}
      noindex={noindex}
      canonical={canonical}
      alternates={alternates}
      ogImage={ogImage ?? chrome.ogImage}
      ogImageAlt={ogImage ? title : chrome.ogImageAlt}
      jsonLd={jsonLd}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <AnalyticsNoscript />
    <a
      href="#contenido"
      class="bg-ink text-ink-inverse sr-only z-50 rounded-lg px-4 py-2 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t(locale, "a11y.skipToContent")}
    </a>
    <Header chrome={chrome} locale={locale} alternates={alternates} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer chrome={chrome} locale={locale} />
    <ConsentBanner chrome={chrome} locale={locale} />
  </body>
</html>
