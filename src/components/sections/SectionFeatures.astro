---
import Heading from "~/components/ui/Heading.astro"
import { bf } from "~/lib/bf"

import type { SectionProps } from "./registry"

type Props = SectionProps<"features">

const { id, area, isFirst, eyebrow, heading, body, items } = Astro.props
---

<section id={id} class="py-16 md:py-24" {...bf(area, id, "shell", "container")}>
  <div class="container-page">
    <div class="max-w-2xl">
      {eyebrow && (
        <p
          class="text-brand-700 text-sm font-semibold tracking-wide uppercase"
          {...bf(area, id, "eyebrow", "copy")}
        >
          {eyebrow}
        </p>
      )}
      <Heading
        isFirst={isFirst}
        class="text-ink mt-2 text-3xl font-bold tracking-tight sm:text-4xl"
        {...bf(area, id, "heading", "style_target")}
      >
        {heading}
      </Heading>
      {body && (
        <p class="text-muted mt-4 text-lg" {...bf(area, id, "body", "copy")}>
          {body}
        </p>
      )}
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li class="border-line bg-surface rounded-card border p-6">
          <h3 class="text-ink text-lg font-semibold">{item.title}</h3>
          <p class="text-muted mt-2 leading-7">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
