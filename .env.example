# ─────────────────────────────────────────────────────────────────────────────
# Bin Astro Template — variables de entorno
# TODAS son opcionales: el sitio compila sin ninguna.
# Local: copia este archivo a .env (pnpm setup lo hace por ti).
# Vercel: Project Settings → Environment Variables.
# Guía: docs/guias/variables-de-entorno.md
# ─────────────────────────────────────────────────────────────────────────────

# Dominio canónico con https y sin / final. En Vercel, si falta, se usa el
# dominio de producción del proyecto.
PUBLIC_SITE_URL=

# Fuerza noindex en todo el sitio (útil para un sitio en construcción).
NOINDEX=false

# ── Medición (opcional) ── docs/guias/analytics.md
# Si pones GTM, configura GA4 dentro de Tag Manager y deja GA4_ID vacío.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
# Solo el valor "content" de la meta google-site-verification (mejor verifica por DNS).
PUBLIC_GSC_VERIFICATION=

# ── Formularios (opcional) ── docs/guias/formularios-y-email.md
# none | web3forms | sendgrid   (sin configurar: se muestra un enlace mailto)
PUBLIC_FORMS_PROVIDER=none
PUBLIC_WEB3FORMS_ACCESS_KEY=

# SendGrid (solo si PUBLIC_FORMS_PROVIDER=sendgrid). Secretos: nunca los subas a Git.
SENDGRID_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_TO_EMAIL=

# ── Newsletter con MailerLite (opcional) ──
PUBLIC_NEWSLETTER_ENABLED=false
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# ── Figma (solo para las skills de diseño; el sitio no las usa) ──
# Token personal de solo lectura y la clave del archivo (figma.com/design/<FILE_KEY>/...).
FIGMA_API_KEY=
FIGMA_FILE_KEY=
