#!/usr/bin/env sh

# main se protege: el trabajo va en ramas (feature/*, fix/*, contenido/*).
# Se permite el primer commit del repo y ALLOW_MAIN_COMMIT=1 como escape.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$branch" = "main" ] && git rev-parse --verify HEAD >/dev/null 2>&1 && [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
  echo "error: no hagas commit directo a main. Crea una rama: git switch -c feature/mi-cambio"
  exit 1
fi

pnpm run pretty-quick
pnpm run lint
pnpm run typecheck

echo
echo "todo en orden"
echo
