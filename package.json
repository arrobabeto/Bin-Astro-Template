{
  "name": "bin-astro-template",
  "displayName": "Bin Astro Template",
  "version": "0.1.0",
  "description": "Template Astro sin CMS: contenido en Git, SEO completo, calidad automatizada y listo para Binflow (BSI).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve-static.mjs",
    "setup": "node scripts/setup.mjs && astro sync && husky",
    "bootstrap": "node scripts/bootstrap.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretty-quick": "pretty-quick --staged",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integracion",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "bsi:sync": "node scripts/bsi-sync.mjs",
    "seo:extract": "node scripts/seo-extract.mjs",
    "check:node": "node scripts/check-node-pin.mjs",
    "check:leakage": "node scripts/check-key-leakage.mjs",
    "check:placeholders": "node scripts/check-content-placeholders.mjs",
    "check:docs": "node scripts/check-doc-references.mjs",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "check:sections": "node scripts/check-section-contracts.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:site-url": "node scripts/check-production-site-url.mjs",
    "check:bsi": "node scripts/check-bsi.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:no-localhost": "node scripts/check-no-localhost.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "build:ci": "node scripts/build-ci.mjs",
    "check:source": "pnpm run check:node && pnpm run check:placeholders && pnpm run check:docs && pnpm run check:assets && pnpm run check:sections && pnpm run check:skills && pnpm run check:i18n && pnpm run check:site-url && pnpm run check:headers",
    "check:dist": "pnpm run check:bsi && pnpm run check:seo && pnpm run check:redirects && pnpm run check:no-localhost && pnpm run check:leakage",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run check:source && pnpm run test && pnpm run test:integration && pnpm run build:ci && pnpm run check:dist && pnpm run test:e2e"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@typescript-eslint/parser": "^8.70.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pretty-quick": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
